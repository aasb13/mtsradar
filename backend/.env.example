# Скопируйте в .env:  cp .env.example .env   (Windows: copy .env.example .env)
ENV=dev
LOG_LEVEL=INFO

MONGO_URL=mongodb://localhost:27017
MONGO_DB=incidents
REDIS_URL=redis://localhost:6379/0
RABBIT_URL=amqp://guest:guest@localhost:5672/

# Обязательно поменять перед показом! Сгенерировать:  python -c "import secrets; print(secrets.token_urlsafe(48))"
JWT_SECRET=change-me-please-at-least-32-bytes-long!!
ACCESS_TOKEN_TTL_MIN=30
REFRESH_TOKEN_TTL_DAYS=7
CORS_ORIGINS=["http://localhost:5173","http://localhost:3000"]
# ключ для ИИ-сервиса и внешней ITSM (заголовок X-Service-Key)
SERVICE_API_KEY=dev-service-key

BOOTSTRAP_ADMIN_EMAIL=admin@example.com
BOOTSTRAP_ADMIN_PASSWORD=admin12345

# файл с данными: точка начала + живые правки на демо (лежит в data/ корня репозитория).
# Правки остальных *.json в той же папке (например, character_problems.json) тоже доезжают:
# основной файл — снимок (архивация пропавших), остальные — только применение их записей.
DATA_FILE=../data/incidents.json
WATCH_DATA_FILE=true
WATCH_FORCE_POLLING=false
IMPORT_MISSING_POLICY=archive
WRITE_BACK_TO_FILE=false

COORDINATORS_GROUP_NAME=КЦ ИТ Координаторы Массовых Инцидентов
CRITICAL_PRIORITY_ID=4
HIGH_PRIORITY_ID=3
CRITICAL_RESOLVED_VISIBLE_MINUTES=60
CRITICAL_NEW_MINUTES=15
ITSM_BASE_URL=http://localhost:8000/itsm/incident/
ITSM_MOCK_ENABLED=true
DASHBOARD_URL=http://localhost:5173/
BUSINESS_TZ=Europe/Moscow
SLA_WARNING_RATIO=0.30
SLA_DANGER_RATIO=0.10
SLA_CHECK_INTERVAL_SEC=30

# --- Telegram-бот (см. docs/TELEGRAM.md) ---
# Токен от @BotFather. Только здесь, в .env (он в .gitignore) — не в коде и не в git!
TELEGRAM_BOT_TOKEN=
# https-адрес, по которому Telegram откроет мини-апп входа (туннель: cloudflared tunnel --url http://localhost:8000)
PUBLIC_BASE_URL=
TELEGRAM_INIT_DATA_MAX_AGE_SEC=3600

# --- push в мобильное приложение (см. docs/MOBILE.md) ---
# JSON-ключ сервисного аккаунта Firebase. Положите файл рядом с проектом, в git НЕ коммитьте.
FCM_SERVICE_ACCOUNT_FILE=

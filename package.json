{
  "name": "mts-incident-dashboard",
  "private": true,
  "workspaces": [
    "frontend"
  ],
  "scripts": {
    "dev": "npm run dev:backend & npm run dev --workspace frontend & wait",
    "dev:backend": "cd backend && exec .venv/bin/uvicorn app.main:app --reload --port 8000",
    "build": "npm run build --workspace frontend",
    "preview": "npm run preview --workspace frontend"
  },
  "packageManager": "npm@12.2.2"
}
